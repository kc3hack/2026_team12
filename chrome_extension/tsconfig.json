{
  "compilerOptions": {
    "outDir": "./bin",
    "rootDir": "./src",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM"]
  },
  "include": ["src/**/*.ts","src/**/*.d.ts"],
  "exclude": ["node_modules", "bin"],
  "types": ["chrome-types"]
}