{
  "name": "衝動買い防止拡張機能",
  "description": "あなたの衝動買いをおさえます。",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "bin/index.html",
    "default_icon": "images/extension_icon.png"
  },
  "icons": {
    "16": "images/extension_icon.png",
    "32": "images/extension_icon.png",
    "48": "images/extension_icon.png",
    "128": "images/extension_icon.png"
  },
  "content_scripts": [
    {
      "js": ["bin/content.js"],
      "matches": [
        "https://www.amazon.co.jp/*"
      ]
    }
  ]
}